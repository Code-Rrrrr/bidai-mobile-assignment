<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="36dp">

                <TextView
                    android:id="@+id/backButton"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical|start"
                    android:text="‹"
                    android:textColor="#222222"
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Sell your Product"
                    android:textColor="#111111"
                    android:textStyle="bold"
                    android:textSize="14sp" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Select Categories"
                android:textColor="#111111"
                android:textStyle="bold"
                android:textSize="12sp" />

            <GridLayout
                android:id="@+id/sellCategoryGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:columnCount="4"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="true" />

            <!-- Photo upload -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp"
                android:background="@drawable/photo_upload_background">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="＋"
                    android:textColor="#0870F5"
                    android:textSize="28sp" />

                <Button
                    android:id="@+id/selectPhotosButton"
                    android:layout_width="160dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="2dp"
                    android:backgroundTint="#0868E8"
                    android:text="Select or Take Photo"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/photoCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Upload photos (Min 2, Max 5)"
                    android:textColor="#333333"
                    android:textSize="9sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="5dp"
                    android:fillViewport="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/selectedPhotosContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Seller type -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Sell as"
                android:textColor="#111111"
                android:textStyle="bold"
                android:textSize="12sp" />

            <RadioGroup
                android:id="@+id/sellerTypeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <RadioButton
                    android:id="@+id/vendorRadio"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="Vendor / Business"
                    android:textColor="#222222"
                    android:textSize="11sp" />

                <RadioButton
                    android:id="@+id/individualRadio"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="Individual"
                    android:textColor="#222222"
                    android:textSize="11sp" />
            </RadioGroup>

            <!-- Brand -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Brands"
                android:textColor="#111111"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/brandInput"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/input_background"
                android:hint="Enter Brands"
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:textSize="11sp" />

            <!-- Product type -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Select Product Type"
                android:textColor="#111111"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/productTypeInput"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/input_background"
                android:hint="Type"
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:textSize="11sp" />

            <!-- Ad title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ad Title"
                android:textColor="#111111"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/titleInput"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/input_background"
                android:hint="Enter Title"
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:textSize="11sp" />

            <!-- Description -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Description"
                android:textColor="#111111"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/descriptionInput"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/input_background"
                android:gravity="top|start"
                android:hint="Enter description"
                android:padding="10dp"
                android:inputType="textMultiLine|textCapSentences"
                android:textSize="11sp" />

            <!-- Price -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Price"
                android:textColor="#111111"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/priceInput"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/input_background"
                android:hint="Enter price"
                android:inputType="numberDecimal"
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:textSize="11sp" />

            <!-- Location -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Location"
                android:textColor="#111111"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/locationInput"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/input_background"
                android:hint="Enter location"
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/sellStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="#D32F2F"
                android:textSize="12sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/sellProgress"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/uploadProductButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#0868E8"
                android:text="Upload"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂&#10;Home"
            android:textColor="#333333"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navSell"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♟&#10;Sell"
            android:textColor="#0868E8"
            android:textStyle="bold"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navOneClick"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="✧&#10;One click sell"
            android:textColor="#333333"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/navChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▤&#10;Chat"
            android:textColor="#333333"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navItems"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▢&#10;Your items"
            android:textColor="#333333"
            android:textSize="9sp" />
    </LinearLayout>

</LinearLayout>
